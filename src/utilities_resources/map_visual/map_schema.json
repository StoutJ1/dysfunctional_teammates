{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Versatile Map System Schema v2.1",
  "description": "An improved, robust schema for representing various environments including science facilities, towns, cities, and buildings. Includes color definitions for room types.",
  "type": "object",
  "properties": {
    "metadata": {
        "agents_present":["Donica","Bob"],

      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "environment_name": { "type": "string" },
        "environment_type": {
          "type": "string",
          "enum": ["science_facility", "small_town", "big_city", "office_building", "other"]
        },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "room_type_colors": {
          "type": "object",
          "description": "Mapping of room type to hex color code.",
          "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      },
      "required": ["environment_name", "environment_type", "version"]
    },
    "rooms": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "properties": { "type": "object" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" }
              },
              "required": ["name"]
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_room_id": { "type": "string" },
                "type": { "type": "string" }
              },
              "required": ["target_room_id", "type"]
            }
          }
        },
        "required": ["id", "name", "connections"]
      }
    }
  },
  "required": ["metadata", "rooms"]
}

